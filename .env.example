# Copy to .env and fill in values. Nothing here is required to run the
# free local mode.

# LLM provider selection: "ollama" (free, local) or "claude" (cloud API).
LLM_PROVIDER=ollama

# --- Ollama (local dev mode) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# --- Claude (cloud production mode) ---
# Required when LLM_PROVIDER=claude. Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-3-5-sonnet-latest

# --- Langfuse tracing (optional) ---
# Tracing is off unless both keys are set.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
